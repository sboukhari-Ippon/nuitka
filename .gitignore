# Espace de travail de l'app (registre, verrou, journaux) — jamais versionné
.mm-app/
.maistermind-app/

# Python
__pycache__/
*.py[cod]

# Sauvegardes d'équipement
*.bak-*

# Binaires Nuitka (7-15 Mo pièce, artefacts de build — pas des sources).
# Règle : un binaire porte le nom de son script SANS extension ; les sources
# .py restent versionnées, elles. La liste = le champ `binary` d'orchestrators.json
# (13 entrées) ; à tenir à jour à chaque renommage d'orchestrateur.
*/*/MAIsterMind_App
*/*/engine/Coding-Without-Tests
*/*/engine/Design-Prototype
*/*/engine/Coding
*/*/engine/Test-First
*/*/engine/Acceptance-First
*/*/engine/Spec
*/*/engine/Challenge-Need
*/*/engine/Documentation
*/*/engine/Audit-Design
*/*/engine/Pre-Audit-A11Y-RGAA
*/*/engine/Skills-Adaptation
*/*/engine/Guided-Fix

# Sorties de build locales
out/
dist/
*.tar.gz

# Outillage local de l'assistant — jamais versionné
.claude/
